# 로컬: 이 파일을 .env.local 로 복사해서 값을 채워요. Vercel: Project Settings → Environment Variables 에 같은 이름으로 넣어요.
# NEXT_PUBLIC_ 로 시작하는 값은 브라우저 번들에 포함돼요(공개돼도 되는 값만).

# ── Phase 0 ─────────────────────────────────────
# 캐릭터 이미지 폴더 URL (Supabase Storage 공개 버킷). 비우면 도형 캐릭터로 그려요.
# 예: https://<project-ref>.supabase.co/storage/v1/object/public/mini-world-characters
NEXT_PUBLIC_CHARACTER_BASE_URL=

# ── Phase 3 · 닉네임 로그인, 클라우드 저장 ──────────
# Supabase 대시보드 → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# publishable key(sb_publishable_...) 또는 legacy anon key. RLS로 보호되므로 공개돼도 괜찮아요.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Phase 4 · 점수 제출(app/api/runs), 서버 전용 ────
# secret key(sb_secret_...) 또는 legacy service_role key. 절대 NEXT_PUBLIC_ 붙이지 말 것.
SUPABASE_SECRET_KEY=
